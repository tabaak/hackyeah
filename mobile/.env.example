# Copy to .env.local (gitignored). EXPO_PUBLIC_* values are bundled into the app.
# Same values as frontend/.env.local. Supabase: publishable/anon key only, never the secret one.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# On a physical device use your machine's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
