# Export these in the shell before starting the local service. Do not commit real keys.
CONTROL_DATA_DIR=.control-data
CONTROL_GATE=openjev
CONTROL_QWEN_URL=http://127.0.0.1:8001/v1
# Must EXACTLY match the server's /v1/models ID and identify Qwen3.8-27B.
CONTROL_QWEN_MODEL=Qwen3.8-27B
# Local MLX checkpoint directory: config.json with 4-bit quantization and safetensors weights.
CONTROL_QWEN_PATH=
CONTROL_OPENJEV_URL=http://127.0.0.1:8003/v1
CONTROL_OPENJEV_MODEL=Qwen/Qwen2.5-0.5B-Instruct
TYPESAFE_API_KEY=
CONTROL_JEV_MODEL=jev-latest
CONTROL_PRICING_JSON={}
# The HTTP API also requires the existing Supabase JWT/organization configuration.
# Fixture CLI requires none of the Supabase credentials.
