# Copy to backend/.env (gitignored) and fill in.

# Supabase -> Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret key (sb_secret_...) or legacy service_role key. Server-side only, never ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects still signing user tokens with the legacy HS256 secret (Project Settings -> JWT Keys).
SUPABASE_JWT_SECRET=

# Frontend origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:5173

# OpenAI-compatible chat model. Unreachable -> template drafts and heuristic analysis.
LLM_BASE_URL=http://localhost:8001/v1
LLM_MODEL=bonsai-2-27b
LLM_API_KEY=

# Cloud chat model, also used for document summaries. Public documents only, unless LLM_FORCE=cloud.
OPENAI_API_KEY=
OPENAI_MODEL=
# LLM_FORCE=cloud        # DEV ONLY: send every document, including confidential/restricted, to OPENAI_MODEL

# OpenAI-compatible embeddings, 1536 dims (e.g. https://api.openai.com/v1 + text-embedding-3-small).
# Empty -> keyword retrieval.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=

# Google News via Serper (https://serper.dev). Empty -> news sync disabled.
SERPER_API_KEY=

# Demo data: sample mentions for each new company; >0 adds one live mention every N seconds.
# Expo push service: only needed when "enhanced push security" is enabled for the Expo project
EXPO_ACCESS_TOKEN=

DEMO_SEED=false

DEMO_LIVE_INTERVAL_SECONDS=0

# Integration tests only (pytest tests/test_integration.py): email of a user who has signed in once.
INTEGRATION_USER_EMAIL=
