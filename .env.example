# Copy to .env (git-ignored) and fill in. Values below are placeholders; empty values mean "not set".

# Supabase
SUPABASE_URL=
# Backend-only secret key (or legacy service_role key); never use in VITE_* settings.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Cloud LLM (public data only). Both the key and the model are needed, otherwise everything goes to the local LLM.
OPENAI_API_KEY=
# OPENAI_KEY=              # accepted as an alias of OPENAI_API_KEY
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional local LLM endpoint. In Docker, use http://host.docker.internal:<port>/v1 to reach a host process.
LLM_BASE_URL=
LOCAL_LLM_MODEL=bonsai-2-27b
# LOCAL_LLM_API_KEY=not-needed

# Optional
# LLM_FORCE=local        # send everything, including public, to the local model
# LLM_FORCE=cloud        # DEV ONLY: send everything, including confidential/restricted, to OPENAI_MODEL
# LLM_TIMEOUT_S=120
SERPER_API_KEY=
APIFY_TOKEN=
# Apify cost bounds: posts per run per platform (X ~$0.00015/post, Facebook ~$0.006, Threads ~$0.01) and max post age (days)
# APIFY_LIMIT_X=200
# APIFY_LIMIT_FACEBOOK=30
# APIFY_LIMIT_THREADS=10
# APIFY_MAX_AGE_DAYS=30

# News volume: Serper gives 10 articles per page (1 credit each); Google News RSS is free (up to 100 per request)
# SERPER_PAGES=3
# NEWS_WINDOW=w            # h | d | w | m
# NEWS_RSS=true
# LLM_ANALYSE_ALL=false    # true: the LLM reads every item (~6 s each); false: only items with a risk signal

# Set to false to show only real data (no sample mentions for new companies)
DEMO_SEED=true
