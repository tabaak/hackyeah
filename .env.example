# Copy to .env (git-ignored) and fill in. Values below are placeholders; empty values mean "not set".

# Supabase
SUPABASE_URL=
# Backend-only secret key (or legacy service_role key); never use in VITE_* settings.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Cloud LLM (public data only). Both the key and the model are needed, otherwise everything goes to the local LLM.
OPENAI_API_KEY=
# OPENAI_KEY=              # accepted as an alias of OPENAI_API_KEY
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional local LLM endpoint. In Docker, use http://host.docker.internal:<port>/v1 to reach a host process.
LLM_BASE_URL=
LOCAL_LLM_MODEL=bonsai-2-27b
# LOCAL_LLM_API_KEY=not-needed

# Optional
# LLM_FORCE=local        # send everything, including public, to the local model
# LLM_FORCE=cloud        # DEV ONLY: send everything, including confidential/restricted, to OPENAI_MODEL
# LLM_TIMEOUT_S=120
SERPER_API_KEY=
APIFY_TOKEN=
# Apify cost bounds: posts per run per platform (X ~$0.00015/post, Facebook ~$0.006) and max post age (days)
# APIFY_LIMIT_X=50
# APIFY_LIMIT_FACEBOOK=30
# APIFY_LIMIT_REDDIT=30    # per query, ~$0.001/post (Reddit's own API needs an approved app)
# APIFY_MAX_AGE_DAYS=30

# News. Serper gives 10 articles per page (1 credit each); Google News RSS is free (up to 100 per request).
# Regular runs only look for what is new; a company's history is loaded once, the first time it is synced.
# SERPER_PAGES=1           # pages per query in regular runs
# NEWS_WINDOW=h            # h | d | w | m: how far back regular runs look
# NEWS_RSS=true
# NEWS_BACKFILL_DAYS=60    # history depth of the one-time run (weekly RSS ranges); 0 = no history run
# NEWS_BACKFILL_PAGES=5    # Serper pages per query over the last month in the history run

# Scheduler: minutes between automatic runs per source, 0 = never (manual POST /feed/sources/{platform}/sync always works).
# Cost guide per company: news ~300 Serper credits/day at 10 min; X ~$1.1/day (50 posts every 10 min); Reddit ~$0.001/post; Facebook ~$0.2/run; Bluesky free
# SYNC_ENABLED=true
# SYNC_NEWS_MINUTES=10
# SYNC_X_MINUTES=10
# SYNC_FACEBOOK_MINUTES=720
# SYNC_REDDIT_MINUTES=15
# SYNC_BLUESKY_MINUTES=2   # free, no key
# SYNC_STARTUP_DELAY_SECONDS=120   # first pass after start; skipped for sources that ingested within their interval
# NOTIFY_MAX_AGE_HOURS=72          # critical notifications and phone pushes only for mentions this recent
# LLM_ANALYSE_ALL=false    # true: the LLM reads every item (~6 s each); false: only items with a risk signal

# Set to false to show only real data (no sample mentions for new companies)
DEMO_SEED=false

