# Copy to .env (git-ignored) and fill in. Values below are placeholders; empty values mean "not set".

# Supabase
SUPABASE_URL=
# Backend-only secret key (or legacy service_role key); never use in VITE_* settings.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Cloud LLM (public data only). Both the key and the model are needed, otherwise everything goes to the local LLM.
OPENAI_API_KEY=
# OPENAI_KEY=              # accepted as an alias of OPENAI_API_KEY
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional local LLM endpoint. In Docker, use http://host.docker.internal:<port>/v1 to reach a host process.
LLM_BASE_URL=
LOCAL_LLM_MODEL=bonsai-2-27b
# LOCAL_LLM_API_KEY=not-needed

# Optional
# LLM_FORCE=local        # send everything, including public, to the local model
# LLM_TIMEOUT_S=120
SERPER_API_KEY=
APIFY_TOKEN=
