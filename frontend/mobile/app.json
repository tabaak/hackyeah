{
  "expo": {
    "name": "Palladion",
    "slug": "palladion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mshupeikin.palladion",
      "appleTeamId": "368P9H47N6"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#f7f9fa"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.palladion.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-figure.png",
          "imageWidth": 80,
          "resizeMode": "contain",
          "backgroundColor": "#171717"
        }
      ],
      "expo-sqlite",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#8a5a2c"
        }
      ]
    ],
    "scheme": "palladion",
    "backgroundColor": "#171717",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3154c216-2109-46af-ba4d-135c3347b454"
      }
    },
    "owner": "magorr"
  }
}
